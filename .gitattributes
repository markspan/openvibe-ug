# Auto detect text files and perform LF normalization
* text=auto

*.cmd       text eol=crlf
*.cmd-base  text eol=crlf

*.sh        text eol=lf
*.sh-base   text eol=lf

# scripts/linux*    text eol=lf

# SCM syntax highlighting & preventing 3-way merges
pixi.lock merge=binary linguist-language=YAML linguist-generated=true -diff

# Lets a source archive carry its own version. git-archive expands the $Format:...$ placeholder
# in VERSION.txt at archive time, so a build from a downloaded tarball resolves the right version
# without anyone having to know it. See CMake/OvVersion.cmake. In a checkout the file keeps the
# literal placeholder and 'git describe' answers instead.
VERSION.txt export-subst
